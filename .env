# LLM Provider: anthropic | deepseek | auto
LLM_PROVIDER=deepseek

# DeepSeek API (V4 Pro)
DEEPSEEK_API_KEY=sk-85fee39de9f04fec8e9c4b1c011675f4
DEEPSEEK_MODEL=deepseek-v4-pro
#DEEPSEEK_BASE_URL=https://api.deepseek.com/v1   # 可换成代理地址


# Kubernetes connection
# Options: kubeconfig, in-cluster, token
K8S_AUTH_MODE=kubeconfig
K8S_KUBECONFIG_PATH=~/.kube/config
K8S_CONTEXT=
# K8S_API_SERVER=https://...
# K8S_TOKEN=

# MCP Server
MCP_TRANSPORT=stdio
# For HTTP transport:
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3100

# LLM general settings
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2

# Agent
AGENT_MAX_ITERATIONS=15
AGENT_TASK_TIMEOUT_MS=300000

# Logging
LOG_LEVEL=info
