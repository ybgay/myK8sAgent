## 🧩 How to Extend Skill (扩展技能)

### 快速创建新技能

```bash
# 生成技能模板
k8s-agent skill init --path ./my-skill

# 验证技能配置
k8s-agent skill validate --path ./my-skill

# 列出所有可用技能
k8s-agent skill list
```

### 手写一个自定义技能

```python
# my_custom_skill.py
import json
from typing import Any
from k8s_agent.skills.interface import ISkill, SkillContext, SkillTool
from k8s_agent.skills.manifest import SkillManifest


class MyScaleAlertSkill(ISkill):
    """Custom skill: Send alert when deployment scales."""

    def get_manifest(self) -> SkillManifest:
        return SkillManifest(
            name="scale-alert",               # 唯一标识符
            version="1.0.0",
            description="Send alerts when deployments scale",
            author="your-name",
            keywords=["kubernetes", "scaling", "alert"],
            agent_type="tool-only",            # "tool-only" 或 "sub-agent"
            capabilities=["send_scale_alert"],
        )

    def get_tools(self) -> list[SkillTool]:
        return [
            SkillTool(
                name="send_scale_alert",
                description="Send a notification when a deployment scales",
                input_schema={
                    "type": "object",
                    "properties": {
                        "deployment_name": {"type": "string"},
                        "namespace": {"type": "string", "default": "default"},
                        "old_replicas": {"type": "integer"},
                        "new_replicas": {"type": "integer"},
                        "webhook_url": {"type": "string"},
                    },
                    "required": ["deployment_name", "old_replicas", "new_replicas", "webhook_url"],
                },
                handler=self._send_alert,
            ),
        ]

    async def initialize(self, context: SkillContext) -> None:
        self.logger = context.logger
        self.logger.info("scale_alert_skill_ready")

    async def _send_alert(
        self,
        deployment_name: str,
        namespace: str,
        old_replicas: int,
        new_replicas: int,
        webhook_url: str,
    ) -> str:
        """Send the alert via HTTP webhook."""
        import httpx
        async with httpx.AsyncClient() as client:
            await client.post(webhook_url, json={
                "text": f"⚡ Scaling: {namespace}/{deployment_name} "
                        f"{old_replicas} → {new_replicas} replicas"
            })
        return json.dumps({"status": "sent"})


# Required: export factory function
def create_skill():
    return MyScaleAlertSkill()
```

### 注册并使用技能

```python
from k8s_agent.skills.loader import SkillLoader
from k8s_agent.skills.interface import SkillContext
from k8s_agent.skills.registry import SkillRegistry
from k8s_agent.shared.logging import get_logger

# 创建上下文
ctx = SkillContext(
    logger=get_logger("skills"),
    k8s_client=None,  # 可选
    mcp_client_manager=mcp_manager,  # 可选：让技能使用MCP工具
)

# 加载技能
loader = SkillLoader(ctx)
discovered = loader.discover(extra_paths=["./my-skills"])
for path, manifest in discovered:
    skill = await loader.load(path, manifest)
    registry.register(skill)

# 获取技能工具
tools = registry.get_all_tools()

# 执行技能工具
result = await registry.execute_tool("scale-alert", "send_scale_alert", {
    "deployment_name": "my-app",
    "namespace": "production",
    "old_replicas": 1,
    "new_replicas": 3,
    "webhook_url": "https://hooks.slack.com/...",
})
```

### 创建 Sub-Agent 技能

Sub-Agent 技能拥有自己的 system prompt，可以作为独立 Agent 运行：

```python
class MyExpertSkill(ISkill):
    def get_manifest(self):
        return SkillManifest(
            name="my-expert",
            agent_type="sub-agent",      # 关键：设置为 sub-agent
            capabilities=["expert_analysis"],
            agent_config={
                "system_prompt": "You are an expert analyst. Use your tools to analyze data and provide insights.",
                "max_iterations": 5,
            },
        )
    # ... 其余实现相同
```

Sub-Agent 技能会由 `SkillAgent` 包装，拥有独立的 agentic loop。

### 技能发现路径

系统按以下优先级搜索技能：

1. **Built-in**: `k8s_agent/skills/builtin/*` — 内置技能
2. **User**: `~/.k8s-agent/skills/*` — 用户级全局技能
3. **Project**: `./.k8s-agent/skills/*` — 项目级技能
4. **npm/PyPI**: `k8s-agent-skill-*` 包 — 发布的技能包

---

## 🤖 How to Extend Agent (扩展 Agent)

### 创建自定义 Agent 类型

```python
from k8s_agent.core.agents.base import BaseAgent
from k8s_agent.core.communication.message_bus import MessageBus
from k8s_agent.core.communication.context import SharedContext
from k8s_agent.shared.types import AgentCapability, TaskRequest, TaskResult, TaskStatus


class MyCustomAgent(BaseAgent):
    """A custom agent with specialized behavior."""

    def __init__(self, message_bus: MessageBus, context: SharedContext, **kwargs):
        super().__init__(
            agent_type="my-custom",       # 自定义类型名
            name="my-custom-agent",
            message_bus=message_bus,
            context=context,
            capabilities=[
                AgentCapability(
                    name="custom_operation",
                    description="My custom K8s operation",
                    tags=["custom", "kubernetes"],
                ),
            ],
        )
        self.custom_config = kwargs

    async def execute_task(self, task: TaskRequest) -> TaskResult:
        """Implement your task logic here."""
        action = task.params.get("action", task.action)
        params = task.params.get("params", {})

        # Your custom logic
        result = await self._do_custom_work(action, params)

        return TaskResult(
            task_id=task.task_id,
            status=TaskStatus.SUCCESS,
            output=result,
        )

    async def get_available_tools(self) -> list[dict]:
        """Return tools this agent provides."""
        return [
            {
                "name": "my_custom_tool",
                "description": "Does something custom",
                "input_schema": {
                    "type": "object",
                    "properties": {
                        "param": {"type": "string"},
                    },
                    "required": ["param"],
                },
            },
        ]

    async def _do_custom_work(self, action: str, params: dict) -> str:
        # Implement here
        return f"Custom work: {action} completed"
```

### 注册自定义 Agent

```python
from k8s_agent.core.agents.factory import AgentFactory

factory = AgentFactory(message_bus, context, mcp_client_manager, llm_provider)

# 方式 1: 注册 builder
factory.register_builder("my-custom", MyCustomAgent)

# 方式 2: 直接创建
agent = MyCustomAgent(message_bus, context)
await agent.initialize()

# Agent 自动通过 MessageBus 接收任务
# Topic: agent.my-custom.*
```

### Agent 通信

Agent 之间通过 `MessageBus` 通信：

```python
# 发布任务
await message_bus.publish("agent.k8s.list_pods", TaskRequest(
    task_type="k8s",
    action="list_pods",
    params={"namespace": "default"},
))

# 订阅任务
@message_bus.on("agent.k8s.*")
async def handle_k8s_task(topic, message):
    # Process the task
    pass

# 请求-响应模式（等待结果）
result = await message_bus.request(
    "agent.k8s.describe_pod",
    TaskRequest(task_type="k8s", action="describe_pod", params={"name": "my-pod"}),
    timeout=30.0,
)
```

